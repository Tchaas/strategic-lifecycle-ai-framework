DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/strategic_lifecycle
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=unused-by-id-token-flow-this-stage
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
INVITE_TTL=604800
FRONTEND_BASE_URL=https://tchaas.github.io/strategic-lifecycle-ai-framework
EMAIL_PROVIDER=smtp
EMAIL_FROM=
VERIFICATION_TTL=86400
VERIFICATION_RESEND_SECONDS=60
PASSWORD_RESET_TTL=3600
# External mail: use the sender and SMTP details authorized by your mail service.
SMTP_HOST=
SMTP_PORT=587
# starttls (usually 587) or ssl (usually 465); certificate validation is required.
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Credentials belong only in backend .env or the server environment, never VITE_*.
# Test inbox: scripts/run_local.py --email-provider smtp-local (no external delivery).
RATE_LIMIT_ENABLED=false
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SIGNUP_PER_MINUTE=5
RATE_LIMIT_GOOGLE_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_INVITE_ACCEPT_PER_MINUTE=10
MAX_REQUEST_BODY_BYTES=1048576
